@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(HolisticMotion_FOUND TRUE)
unset(HolisticMotion_NOT_FOUND_MESSAGE)
set(HolisticMotion_core_FOUND TRUE)
set(HolisticMotion_collision_FOUND @HOLISTICMOTION_ENABLE_COLLISION@)

# Preserve the historical full-package default. An explicit core request does
# not require discovering the optional collision libraries in a full SDK.
set(_HolisticMotion_components "${HolisticMotion_FIND_COMPONENTS}")
set(_HolisticMotion_default_components FALSE)
if(NOT _HolisticMotion_components)
    set(_HolisticMotion_default_components TRUE)
    set(_HolisticMotion_components core)
    if(@HOLISTICMOTION_ENABLE_COLLISION@)
        list(APPEND _HolisticMotion_components collision)
    endif()
endif()
foreach(_HolisticMotion_component IN LISTS _HolisticMotion_components)
    if(NOT _HolisticMotion_component STREQUAL "core" AND
       NOT _HolisticMotion_component STREQUAL "collision")
        set(HolisticMotion_${_HolisticMotion_component}_FOUND FALSE)
        set(HolisticMotion_NOT_FOUND_MESSAGE
            "Unknown HolisticMotion component: ${_HolisticMotion_component}")
    elseif(_HolisticMotion_component STREQUAL "collision" AND
           NOT HolisticMotion_collision_FOUND)
        set(HolisticMotion_NOT_FOUND_MESSAGE
            "HolisticMotion was built without the collision component")
    endif()
endforeach()
check_required_components(HolisticMotion)
if(NOT HolisticMotion_FOUND)
    unset(_HolisticMotion_components)
    unset(_HolisticMotion_component)
    unset(_HolisticMotion_default_components)
    return()
endif()

find_dependency(Eigen3 CONFIG)
if("core" IN_LIST _HolisticMotion_components)
    if(_HolisticMotion_default_components OR HolisticMotion_FIND_REQUIRED_core)
        find_dependency(fmt CONFIG)
        find_dependency(spdlog CONFIG)
        find_dependency(urdfdom CONFIG)
        if(@HOLISTICMOTION_ENABLE_CUDA@)
            find_dependency(CUDAToolkit @HOLISTICMOTION_NATIVE_CUDA_VERSION@ EXACT)
        endif()
    else()
        # Optional core discovery must likewise preserve an available collision
        # component when core-only dependencies (including CUDA) are missing.
        foreach(_HolisticMotion_dependency IN ITEMS fmt spdlog urdfdom)
            find_package(${_HolisticMotion_dependency} QUIET CONFIG)
            if(NOT ${_HolisticMotion_dependency}_FOUND)
                set(HolisticMotion_core_FOUND FALSE)
                break()
            endif()
        endforeach()
        if(HolisticMotion_core_FOUND AND @HOLISTICMOTION_ENABLE_CUDA@)
            find_package(CUDAToolkit @HOLISTICMOTION_NATIVE_CUDA_VERSION@ EXACT QUIET)
            if(NOT CUDAToolkit_FOUND)
                set(HolisticMotion_core_FOUND FALSE)
            endif()
        endif()
        unset(_HolisticMotion_dependency)
    endif()
    if(HolisticMotion_core_FOUND)
        include("${CMAKE_CURRENT_LIST_DIR}/HolisticMotionCoreTargets.cmake")
    endif()
endif()
if(@HOLISTICMOTION_ENABLE_COLLISION@ AND "collision" IN_LIST _HolisticMotion_components)
    if(_HolisticMotion_default_components OR HolisticMotion_FIND_REQUIRED_collision)
        find_dependency(pinocchio CONFIG)
        find_dependency(coal CONFIG)
    else()
        # Optional collision discovery must not make an otherwise usable core
        # package fail when its optional dependency packages are unavailable.
        set(HolisticMotion_collision_FOUND FALSE)
        find_package(pinocchio QUIET CONFIG)
        if(pinocchio_FOUND)
            find_package(coal QUIET CONFIG)
            if(coal_FOUND)
                set(HolisticMotion_collision_FOUND TRUE)
            endif()
        endif()
    endif()
    if(HolisticMotion_collision_FOUND)
        include("${CMAKE_CURRENT_LIST_DIR}/HolisticMotionCollisionTargets.cmake")
    endif()
endif()

check_required_components(HolisticMotion)
unset(_HolisticMotion_components)
unset(_HolisticMotion_component)
unset(_HolisticMotion_default_components)
