@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(HolisticMotion_FOUND TRUE)
unset(HolisticMotion_NOT_FOUND_MESSAGE)
set(HolisticMotion_model_FOUND TRUE)
set(HolisticMotion_core_FOUND TRUE)
set(HolisticMotion_collision_FOUND @HOLISTICMOTION_ENABLE_COLLISION@)

# Preserve the historical full-package default. An explicit core request does
# not require discovering the optional collision libraries in a full SDK.
set(_HolisticMotion_components "${HolisticMotion_FIND_COMPONENTS}")
set(_HolisticMotion_default_components FALSE)
if(NOT _HolisticMotion_components)
    set(_HolisticMotion_default_components TRUE)
    set(_HolisticMotion_components core)
    if(@HOLISTICMOTION_ENABLE_COLLISION@)
        list(APPEND _HolisticMotion_components collision)
    endif()
endif()
foreach(_HolisticMotion_component IN LISTS _HolisticMotion_components)
    if(NOT _HolisticMotion_component STREQUAL "model" AND
       NOT _HolisticMotion_component STREQUAL "core" AND
       NOT _HolisticMotion_component STREQUAL "collision")
        set(HolisticMotion_${_HolisticMotion_component}_FOUND FALSE)
        set(HolisticMotion_NOT_FOUND_MESSAGE
            "Unknown HolisticMotion component: ${_HolisticMotion_component}")
    elseif(_HolisticMotion_component STREQUAL "collision" AND
           NOT HolisticMotion_collision_FOUND)
        set(HolisticMotion_NOT_FOUND_MESSAGE
            "HolisticMotion was built without the collision component")
    endif()
endforeach()
check_required_components(HolisticMotion)
if(NOT HolisticMotion_FOUND)
    unset(_HolisticMotion_components)
    unset(_HolisticMotion_component)
    unset(_HolisticMotion_default_components)
    return()
endif()

find_dependency(Eigen3 CONFIG)
# Core builds on the model component. Model-only consumers discover neither
# solver/CUDA dependencies nor logging or collision backends.
if("model" IN_LIST _HolisticMotion_components OR
   "core" IN_LIST _HolisticMotion_components)
    # Parser and formatting libraries are implementation dependencies. Static
    # consumers still resolve their symbols, while shared consumers need only
    # the model's public Eigen dependency at configuration time.
    if(NOT "@BUILD_SHARED_LIBS@")
        if(_HolisticMotion_default_components OR HolisticMotion_FIND_REQUIRED_model OR
           HolisticMotion_FIND_REQUIRED_core)
            find_dependency(fmt CONFIG)
            find_dependency(urdfdom CONFIG)
        else()
            find_package(fmt QUIET CONFIG)
            if(NOT fmt_FOUND)
                set(HolisticMotion_model_FOUND FALSE)
            endif()
            if(HolisticMotion_model_FOUND)
                find_package(urdfdom QUIET CONFIG)
                if(NOT urdfdom_FOUND)
                    set(HolisticMotion_model_FOUND FALSE)
                endif()
            endif()
        endif()
    endif()
    if(HolisticMotion_model_FOUND)
        include("${CMAKE_CURRENT_LIST_DIR}/HolisticMotionModelTargets.cmake")
    endif()
endif()
if("core" IN_LIST _HolisticMotion_components)
    set(HolisticMotion_core_FOUND ${HolisticMotion_model_FOUND})
    if(_HolisticMotion_default_components OR HolisticMotion_FIND_REQUIRED_core)
        find_dependency(fmt CONFIG)
        if(NOT "@BUILD_SHARED_LIBS@")
            find_dependency(spdlog CONFIG)
        endif()
        if(@HOLISTICMOTION_ENABLE_CUDA@)
            find_dependency(CUDAToolkit @HOLISTICMOTION_NATIVE_CUDA_VERSION@ EXACT)
        endif()
    elseif(HolisticMotion_core_FOUND)
        find_package(fmt QUIET CONFIG)
        if(NOT fmt_FOUND)
            set(HolisticMotion_core_FOUND FALSE)
        endif()
        if(HolisticMotion_core_FOUND AND NOT "@BUILD_SHARED_LIBS@")
            find_package(spdlog QUIET CONFIG)
            if(NOT spdlog_FOUND)
                set(HolisticMotion_core_FOUND FALSE)
            endif()
        endif()
        if(HolisticMotion_core_FOUND AND @HOLISTICMOTION_ENABLE_CUDA@)
            find_package(CUDAToolkit @HOLISTICMOTION_NATIVE_CUDA_VERSION@ EXACT QUIET)
            if(NOT CUDAToolkit_FOUND)
                set(HolisticMotion_core_FOUND FALSE)
            endif()
        endif()
    endif()
    if(HolisticMotion_core_FOUND)
        include("${CMAKE_CURRENT_LIST_DIR}/HolisticMotionCoreTargets.cmake")
    endif()
endif()
if(@HOLISTICMOTION_ENABLE_COLLISION@ AND "collision" IN_LIST _HolisticMotion_components)
    # The collision companion is always shared and exposes only Eigen types.
    # Backend libraries remain runtime dependencies, without requiring their SDKs.
    include("${CMAKE_CURRENT_LIST_DIR}/HolisticMotionCollisionTargets.cmake")
endif()

# Preserve Conan's former aggregate target using only discovered components.
if(NOT TARGET holistic-motion::holistic-motion)
    add_library(holistic-motion::holistic-motion INTERFACE IMPORTED)
endif()
set(_HolisticMotion_aggregate_links)
if(TARGET HolisticMotion::holistic_motion)
    list(APPEND _HolisticMotion_aggregate_links HolisticMotion::holistic_motion)
elseif(TARGET HolisticMotion::model)
    list(APPEND _HolisticMotion_aggregate_links HolisticMotion::model)
endif()
if(TARGET HolisticMotion::collision)
    list(APPEND _HolisticMotion_aggregate_links HolisticMotion::collision)
endif()
set_property(TARGET holistic-motion::holistic-motion PROPERTY
    INTERFACE_LINK_LIBRARIES "${_HolisticMotion_aggregate_links}")
unset(_HolisticMotion_aggregate_links)

check_required_components(HolisticMotion)
unset(_HolisticMotion_components)
unset(_HolisticMotion_component)
unset(_HolisticMotion_default_components)
